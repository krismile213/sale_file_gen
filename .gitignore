# ============================================================
# sale_file_gen · 独立仓库（月销 + 日销 修改追踪）
# 原则：**只入库代码与文档**；数据、成品、中间产物、工作缓存一律不入。
# 入库范围与 SVN 口径一致，但数据样本也不入（GitHub 不适合放大文件）。
# ============================================================

# ---------- 月销：原始数据 / 成品 / 中间产物 ----------
trunk/data/
trunk/result/
trunk/sale_file_tmp/

# ---------- 日销：12 份工作簿 + 日销数据 ----------
Daily_Sales_Report/1.每日销售数据表/
Daily_Sales_Report/东南亚日销/
Daily_Sales_Report/**/*.xlsx

# ---------- 一次性重算/分发产物、归档 ----------
_archive/
月销表（东南亚）重算_202609/
东南亚次表分发_202609/
东南亚2026-09（发送版本）/

# ---------- 本实例工作缓存（记忆、快照、备份） ----------
.workbuddy/
.workbuddy-ai/

# ---------- IDE / 编辑器配置 ----------
.idea/
.vscode/
.zcode/

# ---------- 缓存 / 临时 / 锁文件 ----------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.log
~$*
*.tmp
_tmp_*
.DS_Store
Thumbs.db

# ---------- 大体积二进制（保留代码依赖用的小表） ----------
*.zip
*.7z
*.rar
*.mp4
*.mov
